#version 450 core

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

struct Particle {
    vec2 position;
    vec2 velocity;
    vec4 color;
};

layout(std430, binding = 0) buffer ParticleBuffer { Particle particles[]; };
layout(std430, binding = 1) buffer GridHeadBuffer { int gridHead[]; };
layout(std430, binding = 2) buffer LinkedListBuffer { int particleList[]; };
layout(std430, binding = 3) buffer TerrainGridBuffer { int terrainGrid[]; };

uniform float u_DeltaTime;
uniform int u_ParticleCount;
uniform ivec2 u_GridSize;
uniform ivec2 u_Resolution;
uniform float u_Time;

const float RADIUS = 0.005;

// PCG Hash
uint randHash(inout uint state) {
    state ^= 2747636419u;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    state ^= state >> 16;
    state *= 2654435769u;
    return state;
}

float randFloat(inout uint state) {
    return float(randHash(state)) / 4294967295.0;
}

// 【全新配置：四分之一定位点】
const vec2 BASES[4] = vec2[](
    vec2(-0.5, -0.5), // 0: 左下
    vec2(-0.5,  0.5), // 1: 左上
    vec2( 0.5, -0.5), // 2: 右下
    vec2( 0.5,  0.5)  // 3: 右上
);

void main() {
    uint myID = gl_GlobalInvocationID.x;
    if (myID >= u_ParticleCount) return;

    Particle me = particles[myID];

    // ==========================================
    // 【旋转炮台秽土转生逻辑】
    // ==========================================
    if (me.position.x > 10.0) {
        uint seed = myID + uint(u_Time * 10000.0);
        
        // 依然是 1% 的重生概率控制流量
        if (randFloat(seed) < 0.01) {
            int myTeam = int(myID) % 4; // 改成 4 个阵营
            me.position = BASES[myTeam];
            
            // 设定旋转参数
            float rotSpeed = 2.0; // 炮管旋转角速度
            float dir = (myTeam < 2) ? -1.0 : 1.0; // 左边两个(<2)顺时针为负，右边两个逆时针为正
            
            // 计算当前时间的绝对角度
            float baseAngle = dir * rotSpeed * u_Time;
            
            // 加入极微小的随机扰动 (0.05弧度)，让射线看起来像喷火器而不是死板的一条细线
            float angle = baseAngle + (randFloat(seed) - 0.5) * 0.05;
            
            // 赋予沿射线的速度，加入速度差异拉开粒子间距
            float speed = randFloat(seed) * 0.6 + 0.4;
            me.velocity = vec2(cos(angle), sin(angle)) * speed;
            
            me.color = vec4(1.0); // 纯白色波浪
        } else {
            return;
        }
    }

    // --- 后续碰撞与涂地逻辑 ---
    me.position += me.velocity * u_DeltaTime;

    vec2 normPos = clamp((me.position + 1.0) * 0.5, 0.0, 1.0);
    ivec2 myCell = ivec2(normPos * vec2(u_GridSize));

    for (int y = -1; y <= 1; y++) {
        for (int x = -1; x <= 1; x++) {
            ivec2 neighborCell = myCell + ivec2(x, y);
            if (neighborCell.x < 0 || neighborCell.x >= u_GridSize.x || neighborCell.y < 0 || neighborCell.y >= u_GridSize.y) continue;

            int gridIndex = neighborCell.y * u_GridSize.x + neighborCell.x;
            int currID = gridHead[gridIndex];
            int loopLimit = 0;
            
            while (currID != -1 && loopLimit < 50) {
                if (currID != myID) {
                    Particle other = particles[currID];
                    if (other.position.x < 10.0) {
                        vec2 diff = me.position - other.position;
                        float dist = length(diff);
                        float minDist = RADIUS * 2.0;

                        if (dist > 0.0001 && dist < minDist) {
                            vec2 normal = diff / dist;
                            me.position += normal * (minDist - dist) * 0.5;
                            vec2 relativeVel = me.velocity - other.velocity;
                            float velAlongNormal = dot(relativeVel, normal);
                            if (velAlongNormal < 0.0) {
                                me.velocity -= normal * velAlongNormal * 1.0;
                            }
                        }
                    }
                }
                currID = particleList[currID];
                loopLimit++;
            }
        }
    }

    if (me.position.x - RADIUS < -1.0) { me.position.x = -1.0 + RADIUS; me.velocity.x *= -1.0; } 
    else if (me.position.x + RADIUS > 1.0) { me.position.x = 1.0 - RADIUS; me.velocity.x *= -1.0; }
    if (me.position.y - RADIUS < -1.0) { me.position.y = -1.0 + RADIUS; me.velocity.y *= -1.0; } 
    else if (me.position.y + RADIUS > 1.0) { me.position.y = 1.0 - RADIUS; me.velocity.y *= -1.0; }

    vec2 uv = clamp((me.position + 1.0) * 0.5, 0.0, 1.0);
    ivec2 pixelCoord = ivec2(uv * vec2(u_Resolution));
    pixelCoord = clamp(pixelCoord, ivec2(0), u_Resolution - ivec2(1));
    int pixelIndex = pixelCoord.y * u_Resolution.x + pixelCoord.x;

    int myTeam = int(myID) % 4; // 【修改】这里也要取模 4
    int groundOwner = terrainGrid[pixelIndex];

    if (groundOwner != myTeam) {
        atomicExchange(terrainGrid[pixelIndex], myTeam);
        me.position = vec2(999.0, 999.0);
        me.velocity = vec2(0.0, 0.0);
    }

    particles[myID] = me;
}